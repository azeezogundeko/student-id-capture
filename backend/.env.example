# Server Configuration
PORT=5000
NODE_ENV=production

# S3 Configuration (AWS S3 or S3-compatible services)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=student-photo-capture

# S3 Endpoint URL (for S3-compatible services like MinIO, DigitalOcean Spaces, Wasabi, etc.)
# Leave empty or comment out for AWS S3
# Examples:
#   MinIO: http://localhost:9000 or https://minio.example.com
#   DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
#   Wasabi: https://s3.wasabisys.com
#   Backblaze B2: https://s3.us-west-000.backblazeb2.com
S3_ENDPOINT_URL=https://your-s3-endpoint.com

# CORS Configuration (Frontend URL)
FRONTEND_URL=http://localhost:3006

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Admin Authentication
ADMIN_PASSWORD=EngrOgundeko
JWT_SECRET=your_jwt_secret_key_change_this_in_production
